{
  "name": "@forge/forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle-web": "node scripts/bundle-web-assets.mjs",
    "build": "pnpm run build:server && pnpm run build:web && pnpm run bundle-web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "pnpm run build:web && sh -c 'pnpm run dev:server & pnpm run dev:web & wait'",
    "dev:server": "node scripts/kill-port.mjs 3001 && tsx watch --conditions development src/index.ts",
    "dev:web": "vite build --config web/vite.config.ts --watch",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "pnpm run typecheck:server && pnpm run typecheck:web",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.84",
    "@ai-sdk/deepseek": "^2.0.38",
    "@ai-sdk/google": "^3.0.82",
    "@ai-sdk/groq": "^3.0.41",
    "@ai-sdk/mistral": "^3.0.39",
    "@ai-sdk/openai": "^3.0.71",
    "@ai-sdk/openai-compatible": "^2.0.50",
    "@forge/core": "workspace:*",
    "@forge/db": "workspace:*",
    "@forge/sdk": "workspace:*",
    "@forge/ui": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@vitejs/plugin-react": "^4.3.4",
    "ai": "^6.0.205",
    "hono": "^4.6.14",
    "motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "playwright": "^1.60.0"
  }
}
