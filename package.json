{
  "name": "forge",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonaxliang/forge.git"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "start": "pnpm --filter @forge/forge... build && pnpm --filter @forge/forge bundle-web && pnpm --filter @forge/forge start",
    "dev": "turbo dev",
    "build": "turbo build",
    "build:forgecli": "pnpm --filter @forge/forgecli build",
    "lint": "turbo lint",
    "release": "node scripts/release-packages.mjs",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.8",
      "js-yaml": "4.3.0",
      "postcss": "8.5.18"
    }
  }
}
